{
	"name": "builtnorth/theme-skin-switcher",
	"description": "Design skin engine and Site Editor switcher for WordPress block themes.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"ThemeSkinSwitcher\\": "inc/classes/"
		},
		"files": [
			"inc/functions.php"
		]
	},
	"require": {
		"php": ">=8.1",
		"novalis/rest-access": "^1.0"
	},
	"scripts": {
		"test": "echo 'Theme skin switcher tests not yet configured'"
	},
	"config": {
		"optimize-autoloader": false,
		"prepend-autoloader": false
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-main": "2.0.x-dev",
			"dev-dev": "2.0.x-dev",
			"dev-feature/package-architecture-refactor": "2.0.x-dev"
		}
	}
}
