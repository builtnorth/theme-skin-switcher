{
	"name": "builtnorth/theme-skin-switcher",
	"description": "Design skin engine and Site Editor switcher for Compass WaaS themes.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"ThemeSkinSwitcher\\": "inc/classes/"
		}
	},
	"authors": [
		{
			"name": "Built North",
			"homepage": "https://builtnorth.co"
		}
	],
	"require": {
		"php": ">=8.1",
		"builtnorth/polaris": "^2.0"
	},
	"config": {
		"optimize-autoloader": false,
		"prepend-autoloader": false
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-main": "1.0.x-dev"
		}
	}
}
